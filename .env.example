# Environment variables — copy to .env.local and fill in values
# See NEW-PRODUCT-PLAYBOOK.md Phase 6.3 for production guidance

# Required: full URL of this site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.findyouridealpillow.com

# Optional: GA4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Required: category ID must match a key in config/registry.ts
# Used during `next build` as the build-phase category fallback.
# When cloning for a new product, change this to the new category ID.
DEFAULT_CATEGORY_ID=pillow

# Admin panel password (use a strong random string in production)
ADMIN_PASSWORD=
